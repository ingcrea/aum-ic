---
/**
 * 🌍 TIPO: PLANETA
 * 🏷️ NOMBRE: MainFooter
 */
import { useTranslations } from '@i18n/utils';
const t = useTranslations(Astro.currentLocale || 'es');
---

<footer class="planet-footer">
  <p>{t('footer.rights')}</p>
</footer>

<style lang="scss">
  .planet-footer {
    text-align: center;
    padding: 3rem;
    margin-top: 4rem;
    background: #0f0f0f;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    color: #64748b;
    font-size: 0.9rem;
  }
</style>
