---
import LangSwitcher from '@atoms/LangSwitcher.astro';
import { useTranslations } from '@i18n/utils';
const t = useTranslations(Astro.currentLocale || 'es');
---

<header class="planet-header">
  <nav class="nav-container">
    <!-- Logo Oficial IngCrea -->
    <a href="#" class="brand-link">
      <img src="/logo-ic.webp" alt="Ingeniería Creativa" class="logo-image" />
      <span class="arch-name">AUM-IC</span>
    </a>
    
    <!-- Enlaces (Ocultos en móvil) -->
    <div class="nav-links">
      <a href="#">{t('nav.home')}</a>
      <a href="#docs">{t('nav.docs')}</a>
      <a href="https://github.com/ingcrea" target="_blank">GitHub</a>
    </div>

    <!-- Acciones -->
    <div class="nav-actions">
      <LangSwitcher />
    </div>
  </nav>
</header>

<style lang="scss">
  .planet-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 9999;
    
    background: rgba(15, 15, 18, 0.75);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem 3rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    transition: opacity 0.2s;
    
    &:hover { opacity: 0.8; }
    
    .logo-image {
      height: 38px;
      width: auto;
      object-fit: contain;
    }

    .arch-name {
      font-size: 1.1rem;
      font-weight: 800;
      letter-spacing: 0.5px;
      color: #ffffff;
      border-left: 1px solid rgba(255, 255, 255, 0.2);
      padding-left: 1rem;
    }
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
    align-items: center;
    
    a {
      font-size: 0.95rem;
      font-family: system-ui, -apple-system, sans-serif;
      color: #94a3b8;
      text-decoration: none;
      font-weight: 500;
      transition: color 0.2s ease;
      
      &:hover {
        color: #ffffff;
      }
    }
  }

  .nav-actions {
    display: flex;
    align-items: center;
  }

  @media (max-width: 768px) {
    .nav-container { padding: 1rem 1.5rem; }
    .nav-links { display: none; }
  }
</style>
