---
import LangSwitcher from '@atoms/LangSwitcher.astro';
import { useTranslations } from '@i18n/utils';
const t = useTranslations(Astro.currentLocale || 'es');
---

<header class="planet-header">
  <nav class="nav-pill">
    <!-- Logo Oficial IngCrea -->
    <a href="#" class="brand-link">
      <img src="/logo-ic.webp" alt="Ingeniería Creativa" class="logo-image" />
    </a>
    
    <!-- Enlaces (Ocultos en móvil) -->
    <div class="nav-links">
      <a href="#">{t('nav.home')}</a>
      <a href="#docs">{t('nav.docs')}</a>
      <a href="https://github.com/ingcrea" target="_blank">GitHub</a>
    </div>

    <!-- Acciones -->
    <div class="nav-actions">
      <LangSwitcher />
    </div>
  </nav>
</header>

<style lang="scss">
  .planet-header {
    position: fixed;
    top: 2rem;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    z-index: 9999;
    padding: 0 1.5rem;
    pointer-events: none;
  }

  .nav-pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3.5rem;
    
    background: rgba(18, 18, 20, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    width: 100%;
    max-width: 900px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.2s;
    
    &:hover { opacity: 0.8; }
    
    .logo-image {
      height: 32px;
      width: auto;
      object-fit: contain;
    }
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    align-items: center;
    
    a {
      font-size: 0.9rem;
      font-family: system-ui, -apple-system, sans-serif;
      color: #a1a1aa;
      text-decoration: none;
      font-weight: 500;
      transition: color 0.2s ease;
      letter-spacing: 0.3px;
      
      &:hover {
        color: #ffffff;
      }
    }
  }

  .nav-actions {
    display: flex;
    align-items: center;
  }

  @media (max-width: 768px) {
    .nav-pill { gap: 1rem; padding: 0.75rem 1.25rem; }
    .nav-links { display: none; }
    .brand-link .logo-image { height: 26px; }
  }
</style>
