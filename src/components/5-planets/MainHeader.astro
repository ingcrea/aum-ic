---
import LangSwitcher from '@atoms/LangSwitcher.astro';
import { useTranslations } from '@i18n/utils';
const t = useTranslations(Astro.currentLocale || 'es');
---

<header class="planet-header">
  <nav class="nav-pill">
    <!-- Logo Minimalista -->
    <a href="#" class="brand-link">
      <div class="logo-mark">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10" stroke="rgba(255,255,255,0.9)"/>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" stroke="rgba(255,255,255,0.5)"/>
          <path d="M2 12h20" stroke="rgba(255,255,255,0.2)"/>
        </svg>
      </div>
      <span class="brand-name">AUM-IC</span>
    </a>
    
    <!-- Enlaces (Ocultos en móvil) -->
    <div class="nav-links">
      <a href="#">{t('nav.home')}</a>
      <a href="#docs">{t('nav.docs')}</a>
      <a href="https://github.com/ingcrea" target="_blank">GitHub</a>
    </div>

    <!-- Acciones -->
    <div class="nav-actions">
      <LangSwitcher />
    </div>
  </nav>
</header>

<style lang="scss">
  .planet-header {
    position: fixed;
    top: 1.5rem;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    z-index: 9999;
    padding: 0 1rem;
    pointer-events: none; /* Deja clickear a través de las esquinas */
  }

  .nav-pill {
    pointer-events: auto; /* Rehabilita clicks en la pastilla */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    background: rgba(12, 12, 12, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255,255,255,0.05);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    padding: 0.6rem 1.2rem;
    border-radius: 100px; /* Borde circular perfecto */
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    
    .logo-mark {
      display: flex;
      color: #fff;
    }

    .brand-name {
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 1px;
      color: #fff;
    }
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    
    a {
      font-size: 0.85rem;
      color: #94a3b8;
      text-decoration: none;
      font-weight: 500;
      transition: color 0.2s ease;
      
      &:hover {
        color: #fff;
      }
    }
  }

  .nav-actions {
    display: flex;
    align-items: center;
  }

  @media (max-width: 768px) {
    .nav-pill { gap: 1rem; }
    .nav-links { display: none; }
  }
</style>
