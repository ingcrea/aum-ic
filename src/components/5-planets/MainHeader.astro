---
import LangSwitcher from '@atoms/LangSwitcher.astro';
import { useTranslations } from '@i18n/utils';
const t = useTranslations(Astro.currentLocale || 'es');
---

<header class="planet-header">
  <nav class="nav-pill">
    <!-- Logo Oficial IngCrea -->
    <a href="#" class="brand-link">
      <img src="/logo-ic.webp" alt="Ingeniería Creativa" class="logo-image" />
    </a>
    
    <!-- Enlaces (Ocultos en móvil) -->
    <div class="nav-links">
      <a href="#">{t('nav.home')}</a>
      <a href="#docs">{t('nav.docs')}</a>
      <a href="https://github.com/ingcrea" target="_blank">GitHub</a>
    </div>

    <!-- Acciones -->
    <div class="nav-actions">
      <LangSwitcher />
    </div>
  </nav>
</header>

<style lang="scss">
  .planet-header {
    position: fixed;
    top: 1.5rem;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    z-index: 9999;
    padding: 0 1rem;
    pointer-events: none; /* Deja clickear a través de las esquinas */
  }

  .nav-pill {
    pointer-events: auto; /* Rehabilita clicks en la pastilla */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    background: rgba(12, 12, 12, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255,255,255,0.05);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    padding: 0.6rem 1.2rem;
    border-radius: 100px; /* Borde circular perfecto */
  }

  .brand-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    
    .logo-image {
      height: 24px;
      width: auto;
      object-fit: contain;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
    }
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    
    a {
      font-size: 0.85rem;
      color: #94a3b8;
      text-decoration: none;
      font-weight: 500;
      transition: color 0.2s ease;
      
      &:hover {
        color: #fff;
      }
    }
  }

  .nav-actions {
    display: flex;
    align-items: center;
  }

  @media (max-width: 768px) {
    .nav-pill { gap: 1rem; }
    .nav-links { display: none; }
  }
</style>
