---
/**
 * 🌍 TIPO: PLANETA
 * 🏷️ NOMBRE: MainHeader
 * 
 * 🎯 PROPÓSITO:
 * Navegación principal del sitio.
 */
import { useTranslations } from '@i18n/utils';
const t = useTranslations(Astro.currentLocale || 'es');
---

<header class="planet-header">
  <div class="planet-header__logo">
    <span>AUM-IC</span>
  </div>
  <nav class="planet-header__nav">
    <a href="#">{t('nav.home')}</a>
    <a href="#docs">{t('nav.docs')}</a>
    <a href="#">{t('nav.contact')}</a>
  </nav>
</header>

<style lang="scss">
  .planet-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 3rem;
    background: rgba(18, 18, 18, 0.8);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    position: sticky;
    top: 0;
    z-index: 100;

    &__logo span {
      font-size: 1.5rem;
      font-weight: 900;
      color: #fff;
      letter-spacing: 2px;
    }

    &__nav {
      display: flex;
      gap: 2rem;
      
      a {
        color: #cbd5e1;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s;
        
        &:hover { color: #60a5fa; }
      }
    }
  }
</style>
