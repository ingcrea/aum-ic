---
/**
 * 🌍 TIPO: PLANETA
 * 🏷️ NOMBRE: HeroWelcome
 * 
 * 🎯 PROPÓSITO:
 * Renderiza la sección principal (Hero) de la landing page.
 * Demuestra la importación de Átomos y el uso del diccionario i18n.
 * 
 * 🧬 ANATOMÍA:
 * - ⚛️ Átomo: <Button /> (Llamados a la acción)
 */

import Button from '@atoms/Button.astro';
import { useTranslations } from '@i18n/utils';

const lang = Astro.currentLocale || 'es';
const t = useTranslations(lang);
---

<section class="planet-hero">
  <div class="planet-hero__container">
    <span class="planet-hero__badge">{t('hero.badge')}</span>
    <h1 class="planet-hero__title">{t('hero.title')}</h1>
    <h2 class="planet-hero__subtitle">{t('hero.subtitle')}</h2>
    <p class="planet-hero__description">{t('hero.description')}</p>
    
    <div class="planet-hero__actions">
      <Button text={t('hero.cta_primary')} variant="primary" href="#docs" />
      <Button text={t('hero.cta_secondary')} variant="secondary" href="https://github.com" />
    </div>
  </div>
</section>

<style lang="scss">
  .planet-hero {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6rem 2rem 2rem 2rem;
    background: radial-gradient(circle at center, #1a1a2e 0%, #121212 100%);

    &__container {
      max-width: 800px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }

    &__badge {
      background: rgba(59, 130, 246, 0.2);
      color: #60a5fa;
      padding: 0.5rem 1rem;
      border-radius: 9999px;
      font-size: 0.875rem;
      font-weight: bold;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    &__title {
      font-size: 4rem;
      font-weight: 900;
      background: linear-gradient(to right, #60a5fa, #c084fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      line-height: 1.1;
    }

    &__subtitle {
      font-size: 1.5rem;
      color: #94a3b8;
      font-weight: 400;
    }

    &__description {
      font-size: 1.125rem;
      color: #cbd5e1;
      max-width: 600px;
      line-height: 1.6;
    }

    &__actions {
      display: flex;
      gap: 1rem;
      margin-top: 1rem;
    }
  }
</style>
