---
/**
 * ⚛️ TIPO: ÁTOMO
 * 🏷️ NOMBRE: GtmHead
 * 
 * 🎯 PROPÓSITO:
 * Inyecta el script principal de Google Tag Manager en el <head>.
 * Solo se renderiza si la variable de entorno GTM_ID está definida.
 */

export interface Props {
  gtmId?: string;
}

const gtmId = Astro.props.gtmId || import.meta.env.PUBLIC_GTM_ID;
---

{gtmId && (
  <script is:inline define:vars={{ id: gtmId }}>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',id);
  </script>
)}
