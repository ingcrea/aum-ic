---
/**
 * ⚛️ TIPO: ÁTOMO
 * 🏷️ NOMBRE: Button
 * 
 * 🎯 PROPÓSITO:
 * Renderiza un botón reutilizable (primario o secundario).
 * No contiene lógica de negocio, solo propiedades visuales y estilos aislados.
 */

export interface Props {
  text: string;
  variant?: 'primary' | 'secondary';
  href?: string;
}

const { text, variant = 'primary', href } = Astro.props;
const Element = href ? 'a' : 'button';
---

<Element href={href} class={`atom-button atom-button--${variant}`}>
  {text}
</Element>

<style lang="scss">
  /* SCSS Scoped (Aislado matemáticamente por Astro) */
  .atom-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease-in-out;
    cursor: pointer;
    border: none;

    &--primary {
      background-color: #3b82f6; /* Placeholder, ideal usar variables de _variables.scss */
      color: #ffffff;
      &:hover { background-color: #2563eb; transform: translateY(-2px); }
    }

    &--secondary {
      background-color: transparent;
      color: #3b82f6;
      border: 2px solid #3b82f6;
      &:hover { background-color: rgba(59, 130, 246, 0.1); }
    }
  }
</style>
