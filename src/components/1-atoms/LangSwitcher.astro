---
const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith('/en');
const esUrl = isEnglish ? currentPath.replace('/en', '') || '/' : currentPath;
const enUrl = isEnglish ? currentPath : `/en${currentPath === '/' ? '' : currentPath}`;
---

<div class="lang-switcher">
  <a href={esUrl} class={`lang-opt ${!isEnglish ? 'active' : ''}`}>ES</a>
  <span class="separator">|</span>
  <a href={enUrl} class={`lang-opt ${isEnglish ? 'active' : ''}`}>EN</a>
</div>

<style lang="scss">
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.2);
    
    .separator {
      color: rgba(255, 255, 255, 0.15);
      font-size: 0.9rem;
    }

    .lang-opt {
      font-size: 0.85rem;
      font-weight: 600;
      color: #64748b;
      text-decoration: none;
      transition: color 0.2s ease;
      font-family: system-ui, -apple-system, sans-serif;
      
      &:hover {
        color: #cbd5e1;
      }
      
      &.active {
        color: #ffffff;
        text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
      }
    }
  }
</style>
