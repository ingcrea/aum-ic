---
/**
 * ⚛️ TIPO: ÁTOMO
 * 🏷️ NOMBRE: LangSwitcher
 * 
 * 🎯 PROPÓSITO:
 * Cambia el idioma entre Español e Inglés alternando las rutas.
 */
const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith('/en');

// Cálculo simple de rutas (solo para el boilerplate)
const esUrl = isEnglish ? currentPath.replace('/en', '') || '/' : currentPath;
const enUrl = isEnglish ? currentPath : `/en${currentPath === '/' ? '' : currentPath}`;
---

<div class="atom-lang-switcher">
  <a href={esUrl} class={!isEnglish ? 'active' : ''}>ES</a>
  <span class="divider">/</span>
  <a href={enUrl} class={isEnglish ? 'active' : ''}>EN</a>
</div>

<style lang="scss">
  .atom-lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: bold;
    background: rgba(255, 255, 255, 0.1);
    padding: 0.3rem 0.8rem;
    border-radius: 9999px;

    a {
      color: #94a3b8;
      text-decoration: none;
      transition: color 0.2s;

      &:hover { color: #fff; }
      &.active { color: #60a5fa; }
    }

    .divider {
      color: #475569;
    }
  }
</style>
