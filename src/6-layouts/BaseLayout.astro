---
import SeoMeta from '@atoms/SeoMeta.astro';
import GtmHead from '@atoms/GtmHead.astro';
import GtmBody from '@atoms/GtmBody.astro';
import MainHeader from '@planets/MainHeader.astro';
import MainFooter from '@planets/MainFooter.astro';
import '@styles/global.scss';

export interface Props {
  title: string;
  description: string;
  image?: string;
  lang?: 'es' | 'en';
}

const { 
  title, 
  description, 
  image, 
  lang = Astro.currentLocale || 'es' 
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <SeoMeta title={title} description={description} image={image} />
    <GtmHead />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <GtmBody />
    <MainHeader />
    <slot />
    <MainFooter />
  </body>
</html>
