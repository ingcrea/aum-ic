---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroWelcome from '@planets/HeroWelcome.astro';
import * as Docs from '../../README.md';

const { Content } = Docs;
---

<BaseLayout title="AUM-IC | Documentación Oficial" description="Manifiesto Arquitectónico y Estándar de Programación AUM-IC">
  <main>
    <HeroWelcome />
    
    <section class="docs-container">
      <article class="markdown-body">
        <Content />
      </article>
    </section>
  </main>
</BaseLayout>

<style lang="scss">
  .docs-container {
    max-width: 900px;
    margin: 4rem auto;
    padding: 2rem;
    background: #1e1e2f;
    border-radius: 12px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    border: 1px solid rgba(255,255,255,0.05);
  }
</style>
