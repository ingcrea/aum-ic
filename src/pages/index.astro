---
/**
 * 🌌 TIPO: GALAXIA (Controlador)
 * 🏷️ NOMBRE: HomePage (index)
 * 
 * 🎯 PROPÓSITO:
 * Página de aterrizaje del Boilerplate AUM-IC.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import HeroWelcome from '@planets/HeroWelcome.astro';
import { useTranslations } from '@i18n/utils';

const t = useTranslations('es');
---

<BaseLayout 
  title={t('site.title')} 
  description={t('site.description')}
>
  <main>
    <HeroWelcome />
    
    <section id="docs" style="max-width: 800px; margin: 4rem auto; padding: 2rem; color: #fff;">
      <h2 style="font-size: 2rem; margin-bottom: 2rem; text-align: center; color: #60a5fa;">Estructura del Universo</h2>
      <div style="display: grid; gap: 1.5rem;">
        <div style="background: #1e1e2f; padding: 1.5rem; border-radius: 12px; border-left: 4px solid #3b82f6;">
          <h3>{t('features.atom_title')}</h3>
          <p style="color: #94a3b8; margin-top: 0.5rem;">{t('features.atom_desc')}</p>
        </div>
        <div style="background: #1e1e2f; padding: 1.5rem; border-radius: 12px; border-left: 4px solid #a855f7;">
          <h3>{t('features.planet_title')}</h3>
          <p style="color: #94a3b8; margin-top: 0.5rem;">{t('features.planet_desc')}</p>
        </div>
        <div style="background: #1e1e2f; padding: 1.5rem; border-radius: 12px; border-left: 4px solid #10b981;">
          <h3>{t('features.galaxy_title')}</h3>
          <p style="color: #94a3b8; margin-top: 0.5rem;">{t('features.galaxy_desc')}</p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
